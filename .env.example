# PostHog Analytics Configuration
# Get your API key from https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=your_posthog_key_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloud sync needs nothing here. It is provided by plugins -- install one from
# the plugins page and connect it in Settings -- and the provider's client id
# lives in the plugin, not in this app.
